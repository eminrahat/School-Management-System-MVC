@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>@ViewBag.Title - Öğrenci Otomasyon Sistemi</title>

    <!-- Bootstrap 3 CSS -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css">
    <link rel="icon" type="image/png" href="~/Dosyalar1/Logo.png">
    <!-- Senin Özel CSS Dosyan -->
    <link href="~/Dosyalar1/StyleSheet.css" rel="stylesheet" />

    <!-- Admin Paneli Özel Tasarım Kodları -->
    <style>

        /* Özel Kurumsal Panel Tasarımı */
        .panel-kurumsal {
            border-color: #2c3e50;
            border-radius: 0; /* İsteğe bağlı: Köşeleri daha keskin, modern yapar */
        }

            .panel-kurumsal > .panel-heading {
                background-color: #2c3e50;
                color: #ffffff;
                border-color: #2c3e50;
                border-radius: 0;
            }

        /* Kurumsal Özel Buton */
        .btn-kurumsal {
            background-color: #2c3e50;
            color: white;
            border: 1px solid #1a252f;
            transition: 0.3s;
        }

            .btn-kurumsal:hover, .btn-kurumsal:focus {
                background-color: #1a252f;
                color: #f39c12; /* Üzerine gelince sidebar'daki o şık sarı yansıma */
            }

        /* Tablo Başlığı İçin Uyumlu Hafif Gri */
        .tr-kurumsal th {
            background-color: #e8ecef !important;
            color: #2c3e50 !important;
        }



        body {
            background-color: #f4f7f6; /* Sayfa arkaplanı hafif gri ki beyaz paneller patlasın */
        }

        .wrapper {
            display: flex;
            align-items: stretch;
            min-height: 100vh;
        }

        /* --- KENAR ÇUBUĞU (SIDEBAR) TASARIMI --- */
        #sidebar {
            min-width: 250px;
            max-width: 250px;
            background: #2c3e50; /* Koyu lacivert/gri kurumsal renk */
            color: #fff;
            transition: all 0.3s;
        }

            #sidebar.active {
                margin-left: -250px; /* Menü kapandığında sola gizlenir */
            }

            #sidebar .sidebar-header {
                padding: 20px;
                background: #1a252f;
                text-align: center;
                border-bottom: 1px solid #34495e;
            }

            #sidebar ul.components {
                padding: 20px 0;
            }

            #sidebar ul li a {
                padding: 15px 20px;
                font-size: 1.1em;
                display: block;
                color: #ecf0f1;
                text-decoration: none;
                border-left: 4px solid transparent; /* Hover efekti için hazırlık */
                transition: 0.2s;
            }

                #sidebar ul li a:hover {
                    color: #fff;
                    background: #34495e;
                    border-left: 4px solid #f39c12; /* Üzerine gelince sarı çizgi efekti */
                }

                #sidebar ul li a i {
                    margin-right: 10px;
                }

        /* --- ÜST MENÜ (NAVBAR) TASARIMI --- */
        #content {
            width: 100%;
            padding: 0;
            transition: all 0.3s;
        }

        .top-navbar {
            background: #fff;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1); /* Hafif gölge */
            padding: 10px 20px;
            margin-bottom: 0;
            border-radius: 0;
            border: none;
        }

        .content-body {
            padding: 20px; /* İçeriklerin etrafında boşluk olsun */
        }
    </style>
</head>
<body>

    <div class="wrapper">

        <!-- ================= KENAR ÇUBUĞU ================= -->
        <nav id="sidebar">
            <div class="sidebar-header">
                <h4><i class="glyphicon glyphicon-education"></i> <strong>Admin</strong>Panel</h4>
            </div>

            <ul class="list-unstyled components">
                <li>
                    <!-- Linki ogrenc yerine Index yaptım, genelde MVC standartı budur -->
                    <a href="/Ogrenciler/ogrenc"><i class="glyphicon glyphicon-user"></i> Öğrenci İşleri</a>
                </li>
                <li>
                    <a href="/Default/Index"><i class="glyphicon glyphicon-book"></i> Ders Yönetimi</a>
                </li>
                <li>
                    <a href="/Kulupler/Index"><i class="glyphicon glyphicon-star"></i> Kulüp İşlemleri</a>
                </li>
                <li>
                    <a href="/Sınavlar/Index"><i class="glyphicon glyphicon-list-alt"></i> Sınav ve Notlar</a>
                </li>
                <li>
                    <a href="/Default/Iletisim"><i class="glyphicon glyphicon-earphone"></i> Sistem Destek</a>
                </li>
            </ul>
        </nav>

        <!-- ================= ANA İÇERİK ALANI ================= -->
        <div id="content">

            <!-- ÜST NAVBAR -->
            <nav class="navbar navbar-default top-navbar">
                <div class="container-fluid">

                    <div class="navbar-header">
                        <!-- Menü Aç/Kapat Butonu -->
                        <button type="button" id="sidebarCollapse" class="btn btn-kurumsal navbar-btn">
                            <i class="glyphicon glyphicon-align-left"></i>
                            <span>Menüyü Daralt</span>
                        </button>
                    </div>

                    <!-- Sağ Üst Profil Alanı -->
                    <div class="nav navbar-nav navbar-right" style="margin-top: 15px; margin-right: 15px;">
                        <span style="font-size: 14px; color: #555;">
                            <i class="glyphicon glyphicon-user"></i> Hoşgeldin, <strong>Sistem Yöneticisi</strong>
                        </span>
                    </div>

                </div>
            </nav>

            <!-- DİĞER SAYFALARIN (Index, Yeni Ekle vs.) YÜKLENECEĞİ YER -->
            <div class="content-body">
                @RenderBody()
            </div>

        </div>
    </div>

    <!-- jQuery ve Bootstrap JS -->
    <script src="https://code.jquery.com/jquery-1.12.0.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"></script>

    <!-- Menü Aç/Kapat Scripti -->
    <script type="text/javascript">
                $(document).ready(function () {
                    $('#sidebarCollapse').on('click', function () {
                        $('#sidebar').toggleClass('active');
                    });
                });
    </script>
</body>
</html>